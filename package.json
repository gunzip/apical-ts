{
  "name": "@apical-ts/apical-ts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build build:docs",
    "lint:check": "oxlint .",
    "lint": "oxlint --fix .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "turbo run typecheck:code typecheck:tests typecheck:generated",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "generate": "turbo run generate generate:tests",
    "prepublishOnly": "turbo run prepublishOnly",
    "release:patch": "turbo run release:patch",
    "release:minor": "turbo run release:minor",
    "release:major": "turbo run release:major"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@pagopa/eslint-config": "^5.1.2",
    "knip": "^6.34.0",
    "oxfmt": "catalog:",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
