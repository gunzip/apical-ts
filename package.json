{
  "name": "@apical-ts/apical-ts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build build:docs",
    "lint:check": "oxlint .",
    "lint": "oxlint --fix .",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck:code typecheck:tests typecheck:generated",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "generate": "turbo run generate generate:tests",
    "prepublishOnly": "turbo run prepublishOnly",
    "release:patch": "turbo run release:patch",
    "release:minor": "turbo run release:minor",
    "release:major": "turbo run release:major"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@devcontainers/cli": "^0.81.1",
    "@pagopa/eslint-config": "^5.1.2",
    "oxlint": "^1.41.0",
    "turbo": "^2.7.6",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.15.1"
}
