{
  "name": "@apical-ts/examples-msw",
  "version": "0.1.5",
  "private": true,
  "description": "MSW mock server examples for apical-ts generated clients.",
  "type": "module",
  "scripts": {
    "typecheck:code": "tsc -p tsconfig.examples.json",
    "generate": "craft generate -i examples.yaml -o generated --server --client",
    "clean": "rm -rf generated",
    "dev": "node server-examples/mock-server-example.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@apical-ts/craft": "workspace:*",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "msw": "^2.15.0",
    "zocker": "^3.0.0",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
