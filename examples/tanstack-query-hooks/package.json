{
  "name": "@apical-ts/tanstack-query-hooks",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:client": "node ../../apps/craft/dist/index.mjs generate --client -i swagger.json -o generated",
    "generate:hooks": "tsx ./scripts/generate-hooks.ts",
    "generate": "pnpm run generate:client && pnpm run generate:hooks",
    "build": "tsc -p tsconfig.json",
    "typecheck:generated": "tsc --noEmit -p tsconfig.generated.json"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@tanstack/react-query": "^4.44.0",
    "react": "^18.3.1",
    "tsx": "^4.23.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apical-ts/craft": "workspace:*",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^18.3.31",
    "typescript": "catalog:",
    "p-limit": "^7.3.2"
  }
}
