{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "module": "NodeNext",
    "target": "ES2022"
  },
  "include": ["./**/*.ts"],
  "exclude": ["benchmark"]
}
