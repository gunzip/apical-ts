{
  "name": "@apical-ts/examples-hono",
  "version": "0.1.3",
  "private": true,
  "description": "Reusable Hono template generated from Apical TS route metadata.",
  "type": "module",
  "scripts": {
    "typecheck:code": "pnpm run generate:demo && tsgo -p tsconfig.examples.json",
    "generate:routes": "craft generate --routes -i openapi.yaml -o generated",
    "generate:apical": "pnpm run generate:routes",
    "generate:hono": "tsx scripts/generate-hono-server.ts --routes generated/routes --output generated/hono --handlers handlers",
    "generate:mocks": "tsx scripts/generate-hono-server.ts --routes generated/routes --output generated/hono --include-mocks",
    "generate": "pnpm run clean && pnpm run generate:routes && pnpm run generate:hono",
    "generate:demo": "pnpm run clean && pnpm run generate:routes && pnpm run generate:mocks",
    "clean": "rm -rf generated",
    "dev": "pnpm run generate:demo && tsx server-examples/mock-server-example.ts",
    "test": "pnpm run generate:demo && vitest run --config vitest.config.ts",
    "test:watch": "pnpm run generate:demo && vitest --config vitest.config.ts"
  },
  "author": "gunzip",
  "license": "MIT",
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@standard-schema/spec": "catalog:",
    "hono": "^4.13.7",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@apical-ts/craft": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "^4.23.13",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zocker": "^3.0.0"
  }
}
