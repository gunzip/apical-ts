{
  "name": "@apical-ts/craft",
  "version": "0.26.0",
  "private": false,
  "description": "CLI tool for generating fully-typed Zod v4 schemas and type-safe TypeScript REST API clients and server from OpenAPI 2.0, 3.0.x, and 3.1.x specifications.",
  "main": "dist/index.mjs",
  "type": "module",
  "homepage": "https://gunzip.github.io/apical-ts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "craft": "./bin/craft.js"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck:code": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "pnpm typecheck:code && pnpm typecheck:tests",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "generate:tests": "node dist/index.mjs generate -i tests/integrations/fixtures/test.yaml -o tests/integrations/generated --client --server",
    "clean": "rm -rf tests/integrations/generated",
    "start": "node dist/index.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "client",
    "server",
    "generator",
    "cli",
    "zod"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@apical-ts/client-generator": "workspace:*",
    "@apical-ts/core-utils": "workspace:*",
    "@apical-ts/route-generator": "workspace:*",
    "@apical-ts/server-generator": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "@stoplight/prism-cli": "^5.16.0",
    "@tsconfig/node22": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.5.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.3.2",
    "openapi3-ts": "^4.6.1",
    "p-limit": "^7.3.2",
    "swagger2openapi": "^7.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
