{
  "name": "@apical-ts/craft",
  "version": "0.16.0",
  "private": false,
  "description": "CLI tool for generating fully-typed Zod v4 schemas and type-safe TypeScript REST API clients and server from OpenAPI 2.0, 3.0.x, and 3.1.x specifications.",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "craft": "./bin/craft.js"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint --fix src",
    "lint:check": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:code": "tsgo --noEmit",
    "typecheck:tests": "tsgo --noEmit -p tsconfig.tests.json",
    "typecheck": "pnpm typecheck:code && pnpm typecheck:tests",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "generate:tests": "node dist/index.js generate -i tests/integrations/fixtures/test.yaml -o tests/integrations/generated --client --server",
    "clean": "rm -rf tests/integrations/generated",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "openapi",
    "typescript",
    "client",
    "server",
    "generator",
    "cli",
    "zod"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@apical-ts/client-generator": "workspace:*",
    "@apical-ts/core-utils": "workspace:*",
    "@apical-ts/route-generator": "workspace:*",
    "@apical-ts/server-generator": "workspace:*",
    "@stoplight/prism-cli": "^5.14.2",
    "@tsconfig/node22": "catalog:",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "express": "^5.2.1",
    "prettier": "catalog:",
    "supertest": "^7.1.4",
    "tsup": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.2.2",
    "commander": "^14.0.2",
    "js-yaml": "^4.1.1",
    "openapi3-ts": "^4.3.0",
    "p-limit": "^7.1.0",
    "swagger2openapi": "^7.0.8",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
