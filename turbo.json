{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "build:docs": {
      "dependsOn": ["^build:docs"],
      "outputs": ["README.md"]
    },
    "//#lint:check": {},
    "//#lint": {},
    "format": {
      "dependsOn": ["^format"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "typecheck:code": {
      "dependsOn": ["^typecheck:code"]
    },
    "typecheck:tests": {
      "dependsOn": ["^typecheck:tests"]
    },
    "typecheck:generated": {
      "dependsOn": ["^typecheck:generated"]
    },
    "test": {
      "dependsOn": ["^test", "generate:tests"]
    },
    "@apical-ts/tanstack-query-hooks#generate": {
      "dependsOn": ["^build"],
      "outputs": ["generated"]
    },
    "@apical-ts/tanstack-query-hooks#build": {
      "dependsOn": ["generate"],
      "outputs": ["dist/**"]
    },
    "//#test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "apps/**/src/**/*.ts",
        "packages/**/src/**/*.ts",
        "actions/**/src/**/*.ts"
      ],
      "outputs": ["coverage"],
      "outputLogs": "errors-only"
    },
    "clean": {
      "dependsOn": ["^clean"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "generate": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["generated"]
    },
    "generate:tests": {
      "dependsOn": ["build", "^build"],
      "outputs": ["tests/integrations/generated"]
    },
    "prepublishOnly": {
      "dependsOn": ["^prepublishOnly"]
    },
    "release:patch": {
      "dependsOn": ["^release:patch"]
    },
    "release:minor": {
      "dependsOn": ["^release:minor"]
    },
    "release:major": {
      "dependsOn": ["^release:major"]
    }
  }
}
