{
  "name": "@apical-ts/route-generator",
  "version": "0.16.2",
  "private": true,
  "description": "OpenAPI route generator for apical-ts",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openapi",
    "typescript",
    "route",
    "generator"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@apical-ts/core-utils": "workspace:*",
    "openapi3-ts": "^4.6.2",
    "p-limit": "^7.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
