{
  "name": "@apical-ts/route-generator",
  "version": "0.11.0",
  "private": true,
  "description": "OpenAPI route generator for apical-ts",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint --fix src",
    "lint:check": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openapi",
    "typescript",
    "route",
    "generator"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@pagopa/eslint-config": "^5.0.0",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@apical-ts/core-utils": "workspace:*",
    "openapi3-ts": "^4.3.0",
    "p-limit": "^7.1.0",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
