{
  "name": "@apical-ts/core-utils",
  "version": "0.23.0",
  "private": true,
  "description": "Core utilities and generators for apical-ts OpenAPI tooling",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./shared": "./dist/shared/index.js",
    "./shared/*": "./dist/shared/*.js"
  },
  "scripts": {
    "build": "tsgo",
    "build:docs": "embedme README.md && oxfmt README.md",
    "typecheck:code": "tsgo --noEmit",
    "typecheck:tests": "tsgo --noEmit -p tsconfig.tests.json",
    "typecheck": "pnpm typecheck:code && pnpm typecheck:tests",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openapi",
    "typescript",
    "generator",
    "utilities",
    "zod"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/swagger2openapi": "^7.0.4",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "embedme": "catalog:",
    "oxfmt": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "openapi3-ts": "^4.6.1",
    "p-limit": "^7.3.2",
    "swagger2openapi": "^7.0.8",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
