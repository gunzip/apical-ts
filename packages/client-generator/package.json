{
  "name": "@apical-ts/client-generator",
  "version": "0.12.0",
  "private": true,
  "description": "OpenAPI client generator for apical-ts",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsgo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openapi",
    "typescript",
    "client",
    "generator"
  ],
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@apical-ts/core-utils": "workspace:*",
    "openapi3-ts": "^4.3.0",
    "p-limit": "^7.1.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
