{
  "name": "@apical-ts/test-core",
  "version": "0.10.0",
  "private": true,
  "description": "Core test utilities and fixtures for apical-ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "generate:tests": "node ../../apps/craft/dist/index.js generate -i tests/integrations/fixtures/test.yaml -o tests/integrations/generated --client --server",
    "clean": "rm -rf tests/integrations/generated"
  },
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@apical-ts/client-generator": "workspace:*",
    "@apical-ts/core-utils": "workspace:*",
    "@apical-ts/craft": "workspace:*",
    "@apical-ts/route-generator": "workspace:*",
    "@stoplight/prism-cli": "^5.14.2",
    "@tsconfig/node22": "catalog:",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@types/swagger2openapi": "^7.0.4",
    "@vitest/coverage-v8": "^4.0.16",
    "express": "^5.1.0",
    "prettier": "catalog:",
    "supertest": "^7.1.4",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^14.2.0",
    "js-yaml": "^4.1.1",
    "openapi3-ts": "^4.3.0",
    "swagger2openapi": "^7.0.8",
    "zod": "^4.1.8"
  }
}
