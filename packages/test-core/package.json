{
  "name": "@apical-ts/test-core",
  "version": "0.12.3",
  "private": true,
  "description": "Core test utilities and fixtures for apical-ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunzip/apical-ts.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "generate:tests": "node ../../apps/craft/dist/index.mjs generate -i tests/integrations/fixtures/test.yaml -o tests/integrations/generated --client --server",
    "clean": "rm -rf tests/integrations/generated"
  },
  "author": "gunzip",
  "license": "MIT",
  "devDependencies": {
    "@apical-ts/core-utils": "workspace:*",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "openapi3-ts": "^4.3.0",
    "zod": "catalog:"
  }
}
